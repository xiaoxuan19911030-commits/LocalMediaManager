{
  "name": "local-media-manager",
  "private": true,
  "version": "0.7.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bridge:dev": "dotnet run --project backend/LocalMediaManager.Bridge/LocalMediaManager.Bridge.csproj",
    "bridge:publish": "dotnet publish backend/LocalMediaManager.Bridge/LocalMediaManager.Bridge.csproj -c Release -r win-x64 --self-contained false -o src-tauri/resources/bridge",
    "migration:publish": "dotnet publish backend/LocalMediaManager.Migration/LocalMediaManager.Migration.csproj -c Release -r win-x64 --self-contained false -o src-tauri/resources/migration"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.12.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
