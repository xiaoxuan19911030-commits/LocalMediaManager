{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Media Manager Next",
  "version": "0.1.0",
  "identifier": "local.media.manager.next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Local Media Manager",
      "width": 1200,
      "height": 760,
      "minWidth": 900,
      "minHeight": 600,
      "decorations": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://127.0.0.1:47831 data:; connect-src 'self' http://127.0.0.1:47831 http://localhost:1420; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/bridge/*"]
  }
}

